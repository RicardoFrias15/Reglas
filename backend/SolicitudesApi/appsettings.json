{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "<DOMINIO>.onmicrosoft.com",
    "TenantId": "<TENANT_ID>",
    "ClientId": "<CLIENT_ID_API>",
    "Audience": "api://<CLIENT_ID_API>"
  },
  "ConnectionStrings": {
    "Default": "Server=tcp:<servidor>.database.windows.net,1433;Initial Catalog=<bd>;Encrypt=True;TrustServerCertificate=False;Authentication=Active Directory Default;"
  },
  "AzureStorage": {
    "ServiceUrl": "https://<cuenta>.blob.core.windows.net",
    "ContainerName": "solicitudes-docs"
  },
  "AzureCommunication": {
    "Endpoint": "https://<recurso>.<region>.communication.azure.com/",
    "SenderAddress": "DoNotReply@<guid>.azurecomm.net"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "App": {
    "MaxFileSizeMb": 25,
    "AllowedFileExtensions": [ ".pdf", ".doc", ".docx" ]
  }
}
